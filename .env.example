# Copy to .env and fill in

# Database (docker-compose defaults)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=your_postgres_db

# App
SECRET_KEY=replace_with_long_random_secret_key
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=/api-proxy
INTERNAL_API_URL=http://backend:8000

# Yandex OAuth — create app at https://oauth.yandex.ru/
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/auth/callback

# OpenAI
OPENAI_API_KEY=

# Optional: comma-separated Yandex IDs for platform admins (first login becomes admin if empty)
PLATFORM_ADMIN_YANDEX_IDS=

# Dev: skip real Yandex API and use fixtures
YANDEX_MOCK=false
