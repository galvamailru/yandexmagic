# Copy to .env and fill in

# Database (docker-compose defaults)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=your_postgres_db

# App
SECRET_KEY=replace_with_long_random_secret_key
TOKEN_ENCRYPTION_KEY=replace_with_another_long_random_secret_key
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Yandex OAuth — create app at https://oauth.yandex.ru/
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/auth/callback

# LLM (DeepSeek by default, OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Optional: comma-separated Yandex IDs for platform admins (first login becomes admin if empty)
PLATFORM_ADMIN_YANDEX_IDS=
# Optional: comma-separated Yandex logins for platform admins (e.g. mylogin,ceo_login)
PLATFORM_ADMIN_LOGINS=

# Agent safety and alerts
AUTOPILOT_MAX_CHANGES_PER_CYCLE=30
AUTOPILOT_DRY_RUN_DEFAULT=true
ALERT_WEBHOOK_URL=

# Dev: skip real Yandex API and use fixtures.
# In mock mode, Celery agent cycle runs every 5 minutes (instead of every 6 hours).
YANDEX_MOCK=false
